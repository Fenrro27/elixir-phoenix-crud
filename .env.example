# Variables de entorno para desarrollo
# Copiar a .env y ajustar valores
# NO COMMITEAR .env (está en .gitignore)

# Base de datos
DATABASE_URL=ecto://postgres:postgres@localhost:5432/shop_dev

# Phoenix
PHX_HOST=localhost
PORT=4000
SECRET_KEY_BASE=genera_con_mix_phx_gen_secret

# Email (desarrollo - usa Bamboo.LocalAdapter o similar)
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_HOST=
# SMTP_PORT=

# Pagos (v1 = mock, v4+ = Stripe)
PAYMENTS_ADAPTER=Shop.Payments.Mock
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Assets (solo desarrollo)
# NODE_OPTIONS=--max-old-space-size=4096