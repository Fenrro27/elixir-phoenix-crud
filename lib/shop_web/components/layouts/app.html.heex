<header class="border-b border-zinc-200 bg-white/80 backdrop-blur-md sticky top-0 z-30 px-4 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl flex items-center justify-between py-3.5">
    <div class="flex items-center gap-6">
      <a
        href={~p"/products"}
        class="flex items-center gap-2.5 font-bold text-lg text-zinc-900 hover:opacity-90"
      >
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-zinc-900 text-white font-mono text-sm">
          SP
        </span>
        <span>Shop Phoenix</span>
      </a>

      <nav class="hidden md:flex items-center gap-1">
        <.link
          navigate={~p"/products"}
          class="rounded-lg px-3 py-1.5 text-sm font-medium text-zinc-700 hover:bg-zinc-100 transition"
        >
          Catálogo de Productos
        </.link>
        <.link
          navigate={~p"/categories"}
          class="rounded-lg px-3 py-1.5 text-sm font-medium text-zinc-700 hover:bg-zinc-100 transition"
        >
          Categorías
        </.link>
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <.link
        href={~p"/products/new"}
        class="rounded-lg bg-zinc-900 px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-zinc-700 transition"
      >
        + Publicar Producto
      </.link>
      <.link
        href={~p"/categories/new"}
        class="hidden sm:inline-block rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-medium text-zinc-700 hover:bg-zinc-50 transition"
      >
        + Categoría
      </.link>
    </div>
  </div>
</header>

<main class="px-4 py-8 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
