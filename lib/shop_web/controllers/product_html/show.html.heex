<.header>
  {@product.name}
  <:subtitle>Detalle del producto y especificaciones</:subtitle>
  <:actions>
    <.link href={~p"/products/#{@product}/edit"}>
      <.button>Editar Producto</.button>
    </.link>
  </:actions>
</.header>

<div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-3">
  <div class="lg:col-span-2">
    <.list>
      <:item title="Nombre">{@product.name}</:item>
      <:item title="Slug">
        <span class="rounded bg-zinc-100 px-2 py-0.5 font-mono text-xs text-zinc-700">
          {@product.slug}
        </span>
      </:item>
      <:item title="Categoría">
        <.link
          navigate={~p"/categories/#{@product.category}"}
          class="font-medium text-zinc-900 hover:underline"
        >
          {@product.category.name}
        </.link>
      </:item>
      <:item title="Descripción">
        <p class="whitespace-pre-line text-zinc-700">
          {@product.description || "Sin descripción proporcionada."}
        </p>
      </:item>
    </.list>
  </div>

  <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-6 h-fit">
    <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500">
      Resumen Comercial
    </h3>

    <div class="mt-4">
      <div class="text-3xl font-extrabold text-zinc-900">{format_price(@product.price)}</div>
      <div class="mt-3 flex items-center gap-2">
        <span class="text-sm text-zinc-600">Disponibilidad:</span>
        <.stock_badge stock={@product.stock} />
      </div>
      <div class="mt-2 text-xs text-zinc-500">
        Estado:
        <%= if @product.active do %>
          <span class="text-emerald-700 font-medium">Visible en tienda</span>
        <% else %>
          <span class="text-rose-700 font-medium">Oculto</span>
        <% end %>
      </div>
    </div>

    <div class="mt-8 border-t border-zinc-200 pt-6 flex flex-col gap-3">
      <.link
        navigate={~p"/products/#{@product}/edit"}
        class="w-full text-center rounded-lg bg-zinc-900 px-4 py-2 text-sm font-semibold text-white hover:bg-zinc-700 transition"
      >
        Editar Producto
      </.link>
      <.link
        href={~p"/products/#{@product}"}
        method="delete"
        data-confirm="¿Estás seguro de que deseas eliminar este producto permanentemente?"
        class="w-full text-center rounded-lg border border-rose-200 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-100 transition"
      >
        Eliminar Producto
      </.link>
    </div>
  </div>
</div>

<.back navigate={~p"/products"}>Volver a Productos</.back>
