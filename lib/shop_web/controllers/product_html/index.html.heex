<.header>
  Catálogo de Productos
  <:subtitle>Explora, busca y gestiona el inventario de la tienda</:subtitle>
  <:actions>
    <.link href={~p"/products/new"}>
      <.button>+ Nuevo Producto</.button>
    </.link>
  </:actions>
</.header>

<!-- Barra de Búsqueda y Filtros -->
<div class="my-8 rounded-xl border border-zinc-200 bg-zinc-50/70 p-4 shadow-sm">
  <form method="get" action={~p"/products"} class="flex flex-col gap-4 sm:flex-row sm:items-end">
    <div class="flex-1">
      <label
        for="search"
        class="block text-xs font-medium uppercase tracking-wider text-zinc-600 mb-1"
      >
        Buscar Producto
      </label>
      <input
        type="text"
        name="search"
        id="search"
        value={@search_query}
        placeholder="Buscar por nombre o descripción..."
        class="block w-full rounded-lg border-zinc-300 text-sm shadow-sm focus:border-zinc-900 focus:ring-zinc-900"
      />
    </div>

    <div class="w-full sm:w-64">
      <label
        for="category_id"
        class="block text-xs font-medium uppercase tracking-wider text-zinc-600 mb-1"
      >
        Filtrar por Categoría
      </label>
      <select
        name="category_id"
        id="category_id"
        class="block w-full rounded-lg border-zinc-300 text-sm shadow-sm focus:border-zinc-900 focus:ring-zinc-900"
      >
        <option value="">Todas las categorías</option>
        <%= for category <- @categories do %>
          <option value={category.id} selected={to_string(category.id) == @selected_category_id}>
            {category.name}
          </option>
        <% end %>
      </select>
    </div>

    <div class="flex items-center gap-2">
      <button
        type="submit"
        class="rounded-lg bg-zinc-900 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-zinc-700 transition"
      >
        Filtrar
      </button>

      <%= if @selected_category_id != "" or @search_query != "" do %>
        <.link
          href={~p"/products"}
          class="rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm font-semibold text-zinc-700 hover:bg-zinc-50 transition"
        >
          Limpiar
        </.link>
      <% end %>
    </div>
  </form>
</div>

<%= if Enum.empty?(@products) do %>
  <div class="rounded-2xl border-2 border-dashed border-zinc-200 p-12 text-center">
    <svg
      class="mx-auto h-12 w-12 text-zinc-400"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"
      />
    </svg>
    <h3 class="mt-2 text-sm font-semibold text-zinc-900">No se encontraron productos</h3>
    <p class="mt-1 text-sm text-zinc-500">
      Prueba ajustando los filtros de búsqueda o agrega un nuevo producto.
    </p>
    <div class="mt-6">
      <.link href={~p"/products/new"}>
        <.button>Crear Primer Producto</.button>
      </.link>
    </div>
  </div>
<% else %>
  <!-- Vista de Tarjetas / Vitrina -->
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 mb-12">
    <%= for product <- @products do %>
      <div class="group relative flex flex-col justify-between rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm transition hover:shadow-md hover:border-zinc-300">
        <div>
          <div class="flex items-center justify-between gap-2">
            <.link navigate={~p"/categories/#{product.category}"} class="inline-block">
              <span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium text-zinc-700 group-hover:bg-zinc-200 transition">
                {product.category.name}
              </span>
            </.link>
            <.stock_badge stock={product.stock} />
          </div>

          <h3 class="mt-3 text-lg font-semibold text-zinc-900 line-clamp-1">
            <.link navigate={~p"/products/#{product}"} class="hover:text-zinc-600 transition">
              {product.name}
            </.link>
          </h3>

          <p class="mt-1 text-sm text-zinc-500 line-clamp-2">
            {product.description || "Sin descripción disponible."}
          </p>
        </div>

        <div class="mt-5 border-t border-zinc-100 pt-4">
          <div class="flex items-center justify-between">
            <span class="text-xl font-bold tracking-tight text-zinc-900">
              {format_price(product.price)}
            </span>
            <div class="flex items-center gap-2">
              <.link
                navigate={~p"/products/#{product}/edit"}
                class="rounded-md border border-zinc-200 px-2.5 py-1 text-xs font-medium text-zinc-700 hover:bg-zinc-50"
              >
                Editar
              </.link>
              <.link
                navigate={~p"/products/#{product}"}
                class="rounded-md bg-zinc-900 px-2.5 py-1 text-xs font-medium text-white hover:bg-zinc-700"
              >
                Ver
              </.link>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  
<!-- Vista Administrativa (Tabla) -->
  <div class="mt-12">
    <div class="border-t border-zinc-200 pt-8 mb-4">
      <h3 class="text-base font-semibold leading-7 text-zinc-900">
        Inventario y Gestión (Vista Tabla)
      </h3>
      <p class="text-xs text-zinc-500">
        Listado detallado para control de stock, precios y estado activo.
      </p>
    </div>

    <.table id="products_table" rows={@products} row_click={&JS.navigate(~p"/products/#{&1}")}>
      <:col :let={product} label="Nombre">
        <div class="font-medium text-zinc-900">{product.name}</div>
        <div class="text-xs text-zinc-500 font-mono">{product.slug}</div>
      </:col>
      <:col :let={product} label="Categoría">{product.category.name}</:col>
      <:col :let={product} label="Precio">{format_price(product.price)}</:col>
      <:col :let={product} label="Stock"><.stock_badge stock={product.stock} /></:col>
      <:col :let={product} label="Activo">
        <%= if product.active do %>
          <span class="text-xs font-medium text-emerald-600">✓ Activo</span>
        <% else %>
          <span class="text-xs font-medium text-zinc-400">Inactivo</span>
        <% end %>
      </:col>
      <:action :let={product}>
        <.link
          navigate={~p"/products/#{product}/edit"}
          class="font-semibold text-zinc-900 hover:text-zinc-700"
        >
          Editar
        </.link>
      </:action>
      <:action :let={product}>
        <.link
          href={~p"/products/#{product}"}
          method="delete"
          data-confirm="¿Seguro que deseas eliminar este producto?"
          class="font-semibold text-rose-600 hover:text-rose-800"
        >
          Eliminar
        </.link>
      </:action>
    </.table>
  </div>
<% end %>
