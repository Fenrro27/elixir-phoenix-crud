<div class="flex flex-col gap-8">
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-zinc-500" aria-label="Breadcrumb">
    <.link navigate={~p"/"} class="hover:text-zinc-900">Inicio</.link>
    <span>/</span>
    <.link navigate={~p"/"} class="hover:text-zinc-900">Catálogo</.link>
    <span>/</span>
    <.link navigate={~p"/categories/#{@product.category}"} class="hover:text-zinc-900">
      {@product.category.name}
    </.link>
    <span>/</span>
    <span class="text-zinc-900 font-medium truncate max-w-xs">{@product.name}</span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Galería + Info Principal -->
    <div class="lg:col-span-2 flex flex-col gap-6">
      <!-- Imagen Principal -->
      <div class="rounded-2xl border border-zinc-200 bg-white overflow-hidden">
        <div class="aspect-square relative">
          <%= if @product.images != [] do %>
            <img
              src={Enum.at(@product.images, @active_image_index)}
              alt={@product.name}
              class="w-full h-full object-cover transition-opacity duration-300"
            />
          <% else %>
            <div class="w-full h-full flex items-center justify-center bg-zinc-50">
              <svg
                class="h-24 w-24 text-zinc-300"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1"
                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                />
              </svg>
            </div>
          <% end %>
        </div>
        
<!-- Thumbnails -->
        <%= if length(@product.images) > 1 do %>
          <div class="flex gap-2 p-4 overflow-x-auto pb-2">
            <%= for {image, index} <- Enum.with_index(@product.images) do %>
              <button
                phx-click="set_active_image"
                phx-value-index={index}
                class={"flex-shrink-0 w-20 h-20 rounded-lg border-2 overflow-hidden transition " <>
                  if index == @active_image_index, do: "border-zinc-900", else: "border-transparent hover:border-zinc-300"}
                aria-label={"Imagen #{index + 1}"}
                aria-current={if index == @active_image_index, do: "true", else: "false"}
              >
                <img
                  src={image}
                  alt={"#{@product.name} - imagen #{index + 1}"}
                  class="w-full h-full object-cover"
                />
              </button>
            <% end %>
          </div>
        <% end %>
      </div>
      
<!-- Info Principal -->
      <div class="rounded-2xl border border-zinc-200 bg-white p-6">
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1">
            <.link navigate={~p"/categories/#{@product.category}"} class="inline-block mb-2">
              <span class="rounded-full bg-zinc-100 px-3 py-1 text-sm font-medium text-zinc-700">
                {@product.category.name}
              </span>
            </.link>
            <h1 class="text-2xl font-bold text-zinc-900">{@product.name}</h1>
            <p class="mt-2 text-zinc-600">
              {@product.description || "Sin descripción disponible."}
            </p>
          </div>
          <div class="flex flex-col items-end gap-2">
            <span class="text-3xl font-bold text-zinc-900">
              {ShopWeb.ProductHTML.format_price(@product.price)}
            </span>
            <ShopWeb.ProductHTML.stock_badge stock={@product.stock} />
          </div>
        </div>
        
<!-- TODO: feature/shopping-cart - Botón "Añadir al carrito" -->
        <div class="mt-6 p-4 bg-zinc-50 rounded-xl border border-zinc-200 text-center text-sm text-zinc-500">
          🛒 Carrito: implementación en <code>feature/shopping-cart</code>
        </div>
        
<!-- Acciones Admin -->
        <div class="mt-6 flex items-center gap-3 border-t border-zinc-200 pt-4">
          <.link
            navigate={~p"/products/#{@product}/edit"}
            class="rounded-lg border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-50"
          >
            Editar producto
          </.link>
          <.link
            href={~p"/products/#{@product.id}"}
            method="delete"
            data-confirm="¿Seguro que deseas eliminar este producto?"
            class="rounded-lg bg-rose-50 px-4 py-2 text-sm font-medium text-rose-700 hover:bg-rose-100"
          >
            Eliminar
          </.link>
        </div>
      </div>
    </div>
    
<!-- Sidebar: Productos Relacionados -->
    <div class="lg:col-span-1">
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 sticky top-24">
        <h3 class="text-lg font-semibold text-zinc-900">Productos Relacionados</h3>
        <p class="mt-1 text-sm text-zinc-500">Más de {@product.category.name}</p>

        <%= if Enum.empty?(@related_products) do %>
          <p class="mt-4 text-sm text-zinc-500 text-center py-8">
            No hay productos relacionados.
          </p>
        <% else %>
          <div class="mt-4 flex flex-col gap-3">
            <%= for related <- @related_products do %>
              <.product_card product={related} variant={:compact} />
            <% end %>
          </div>
        <% end %>

        <div class="mt-6 pt-6 border-t border-zinc-200">
          <.link
            navigate={~p"/categories/#{@product.category}"}
            class="block text-center text-sm font-medium text-zinc-600 hover:text-zinc-900"
          >
            Ver toda la categoría →
          </.link>
        </div>
      </div>
    </div>
  </div>
</div>
